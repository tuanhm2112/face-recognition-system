# Auto detect text files and perform LF normalization on checkin
* text=auto

# Source code files
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.qss text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pt binary
*.pth binary
*.onnx binary
